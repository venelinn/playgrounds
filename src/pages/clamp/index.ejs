<%- include("/partials/head", {
  title: "Clamp Playground",
  tour: true,
  styles: [
    "/shared/controls.css",
    "/shared/compat.css",
    "/shared/tour.css",
    "/shared/info.css",
    "/shared/preview.css",
    "/pages/clamp/style.css",
  ],
  scripts: [
    "/shared/compat.js",
    "/shared/tour.js",
    "/shared/info.js",
    "/pages/clamp/script.js",
  ],
}) %>
      <p class="app__intro">
        <code>clamp(min, preferred, max)</code> lets text grow and shrink with the screen, within limits.
        It never gets smaller than <strong>min</strong> or bigger than <strong>max</strong>.
        In between, it follows <strong>preferred</strong>, a share of the screen width: <code>5vw</code> means 5% of the width,
        so 45px on a 900px screen. Move the sliders to see where your text stops growing.
      </p>

      <div class="controls">
        <%- include("/components/control/control", {
          id: "min",
          label: "Min",
          min: 8,
          max: 80,
          step: 1,
          value: 20,
          unit: "px",
          inputmode: "decimal",
          numberMin: null,
          numberMax: null
        }) %>

        <%- include("/components/control/control", {
          id: "pref",
          label: "Preferred",
          min: 0.5,
          max: 15,
          step: 0.1,
          value: 5,
          unit: "vw",
          inputmode: "decimal",
          numberMin: null,
          numberMax: null
        }) %>

        <%- include("/components/control/control", {
          id: "max",
          label: "Max",
          min: 24,
          max: 200,
          step: 1,
          value: 80,
          unit: "px",
          inputmode: "decimal",
          numberMin: null,
          numberMax: null
        }) %>

        <%- include("/components/control/control", {
          id: "vw",
          label: "Viewport",
          min: 320,
          max: 1920,
          step: 1,
          value: 900,
          unit: "px",
          inputmode: "decimal",
          sliderLabel: "Viewport width",
          numberMin: null,
          numberMax: null
        }) %>

        <div class="control">
          <label class="control__label" for="font">Font family</label>
          <select class="control__field" id="font">
            <option value="system-ui, sans-serif">System UI</option>
            <option value="&quot;Inter&quot;, sans-serif" data-google="Inter">Inter</option>
            <option value="&quot;Noto Sans&quot;, sans-serif" data-google="Noto Sans">Noto Sans</option>
            <option value="&quot;Nunito Sans&quot;, sans-serif" data-google="Nunito Sans">Nunito Sans</option>
            <option value="&quot;Poppins&quot;, sans-serif" data-google="Poppins">Poppins</option>
            <option value="&quot;Space Grotesk&quot;, sans-serif" data-google="Space Grotesk">Space Grotesk</option>
            <option value="&quot;DM Sans&quot;, sans-serif" data-google="DM Sans">DM Sans</option>
            <option value="&quot;Playfair Display&quot;, serif" data-google="Playfair Display">Playfair Display</option>
            <option value="&quot;Fraunces&quot;, serif" data-google="Fraunces">Fraunces</option>
            <option value="&quot;JetBrains Mono&quot;, monospace" data-google="JetBrains Mono">JetBrains Mono</option>
            <option value="Georgia, serif">Georgia</option>
            <option value="ui-monospace, monospace">UI Monospace</option>
            <option value="custom">Custom…</option>
          </select>
          <input class="control__field" type="text" id="custom-font" placeholder="Font name or Google Fonts link" aria-label="Custom font: installed font name or Google Fonts link" autocomplete="off" spellcheck="false" hidden>
          <p class="control__hint" id="font-status" role="status" hidden></p>
        </div>

        <div class="control">
          <label class="control__label" for="weight">Weight</label>
          <select class="control__field" id="weight">
            <option value="300">300</option>
            <option value="400">400</option>
            <option value="500">500</option>
            <option value="600">600</option>
            <option value="700">700</option>
            <option value="800" selected>800</option>
            <option value="900">900</option>
          </select>
        </div>

        <%- include("/components/control/control", {
          id: "lh",
          label: "Line height",
          min: 0.8,
          max: 2,
          step: 0.05,
          value: 1.1,
          inputmode: "decimal",
        }) %>
      </div>

      <p class="warning" id="warning" role="status" hidden></p>

      <section class="preview" aria-label="Preview">
        <div class="preview__bar">
          <input class="preview__input" type="text" id="sample" value="Fluid Typography" placeholder="Type your text…" aria-label="Preview text" autocomplete="off">
          <span class="preview__note" id="preview-note">drag the corner ↘ to resize</span>
          <span class="preview__badge" id="size-badge">0px</span>
        </div>
        <p class="preview__text" id="text">Fluid Typography</p>
      </section>

      <div class="compare">
        <div class="card">
          <div class="graph">
            <svg class="graph__svg" viewBox="0 0 1000 300" preserveAspectRatio="none" aria-hidden="true">
              <rect class="graph__zone graph__zone--min" id="zone-min" y="0" height="300"></rect>
              <rect class="graph__zone graph__zone--max" id="zone-max" y="0" height="300"></rect>
              <line class="graph__guide graph__guide--min" id="line-min" x1="0" x2="1000"></line>
              <line class="graph__guide graph__guide--max" id="line-max" x1="0" x2="1000"></line>
              <line class="graph__guide graph__guide--vw" id="line-vw" y1="0" y2="300"></line>
              <path class="graph__curve" id="curve"></path>
            </svg>
            <span class="graph__dot"></span>
          </div>
          <div class="graph__axis">
            <span id="axis-start">320px</span>
            <span id="axis-end">1920px</span>
          </div>
        </div>

        <div class="card">
          <div class="card__head">
            <span class="card__title">CSS</span>
            <button class="card__button" type="button" id="copy">Copy</button>
          </div>
          <pre class="card__code"><code id="css-code"></code></pre>
        </div>

        <div class="card">
          <dl class="stats" id="values"></dl>
        </div>
      </div>

<%- include("/partials/footer", {
  features: [
    {
      feature: "min-max-clamp",
      test: "width: clamp(1px, 1vw, 2px)",
      caniuse: "clamp",
      mdn: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/clamp"
    },
  ],
}) %>
