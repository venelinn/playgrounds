<%- include("/partials/head", {
  nav: [
    { id: "settings", label: "Settings" },
    { id: "demo", label: "Cards" },
    { id: "code", label: "Code" },
    { id: "browser-support", label: "Browser support" },
  ],
  title: "Siblings Playground",
  description: "Try CSS sibling-index() and sibling-count(): cards that pick their own color, number and animation delay.",
  appClass: "siblings",
  tour: true,
  styles: [
    "/shared/controls.css",
    "/shared/compat.css",
    "/shared/tour.css",
    "/shared/info.css",
    "/pages/siblings/style.css",
  ],
  scripts: [
    "/shared/compat.js",
    "/shared/tour.js",
    "/shared/info.js",
    "/pages/siblings/script.js",
  ],
}) %>
      <p class="app__intro">
        <code>sibling-index()</code> tells an element its <strong>position</strong> among its siblings: 1, 2, 3…
        <code>sibling-count()</code> tells it <strong>how many</strong> siblings there are.
        Each card below uses them to pick its own color, number and animation delay, with no extra classes.
        Add or remove cards and watch every card adjust.
      </p>
      <p class="support" id="support" role="status" hidden>
        Your browser doesn't support these functions yet. A small script fills in the same values so you can still try it.
      </p>

      <div class="controls" id="settings">
        <%- include("/components/control/control", {
          id: "count",
          label: "Cards",
          min: 1,
          max: 12,
          step: 1,
          value: 8
        }) %>

        <%- include("/components/control/control", {
          id: "stagger",
          label: "Stagger",
          min: 0,
          max: 400,
          step: 10,
          value: 100,
          unit: "ms"
        }) %>

        <%- include("/components/control/control", {
          id: "hue",
          label: "Start hue",
          min: 0,
          max: 359,
          step: 1,
          value: 0,
          unit: "deg",
          rangeClass: "control__range--hue"
        }) %>

        <%- include("/components/control/control", {
          id: "sat",
          label: "Saturation",
          min: 0,
          max: 100,
          step: 1,
          value: 85,
          unit: "%"
        }) %>

        <div class="control control--actions">
          <label class="switch">
            <input class="switch__input" type="checkbox" id="show-values">
            <span class="switch__label">Show values</span>
          </label>
          <button class="replay" type="button" id="replay">
            <svg class="replay__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
            Replay
          </button>
        </div>
      </div>

      <section class="stage" aria-labelledby="stage-title" id="demo">
        <span class="stage__pill">CSS · sibling-index() &amp; sibling-count()</span>
        <h2 class="stage__title" id="stage-title">Featured Products</h2>
        <p class="stage__text">Each card automatically knows its position and total count, rendering completely self-contained color gradients and numbering.</p>
        <div class="products" id="products"></div>
      </section>

      <div class="compare" id="code">
        <div class="card">
          <div class="card__head">
            <span class="card__title">CSS</span>
            <button class="card__button" type="button" id="copy">Copy</button>
          </div>
          <pre class="card__code"><code id="css-code"></code></pre>
        </div>

        <div class="card">
          <div class="card__head" id="inspect-title">Card 1</div>
          <dl class="stats" id="inspect"></dl>
          <p class="card__hint">Hover or focus a card to see its values.</p>
        </div>
      </div>

<%- include("/partials/footer", {
  features: [
    {
      feature: "sibling-count",
      test: "z-index: sibling-index()",
      caniuse: "sibling-index",
      mdn: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/sibling-index"
    },
    {
      feature: "registered-custom-properties",
      label: "@property (registered custom properties)",
      test: "js:registerProperty",
      caniuse: "@property",
      mdn: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules/@property"
    },
  ],
}) %>
