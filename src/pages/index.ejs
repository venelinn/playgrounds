<%- include("/partials/head", {
  title: "CSS Playgrounds",
  description: "Small interactive playgrounds for modern CSS, for designers and developers.",
  appClass: "home",
  home: true,
  styles: [
    "/pages/home.css",
  ],
  scripts: [],
}) %>
      <p class="app__intro">Small interactive tools for modern CSS. Move a slider, see what changes, copy the code. Made for designers and developers.</p>

      <ul class="home__grid">
        <li>
          <a class="tile" href="./clamp/index.html">
            <span class="tile__preview tile__preview--clamp" aria-hidden="true">
              <span>Aa</span><span>Aa</span><span>Aa</span>
            </span>
            <span class="tile__name">Clamp</span>
            <span class="tile__text">Fluid type that grows with the screen, between a smallest and a biggest size.</span>
            <span class="tile__footer">
              <span class="tile__tags"><code>clamp()</code><code>vw</code></span>
              <span class="tile__arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
        <li>
          <a class="tile" href="./siblings/index.html">
            <span class="tile__preview tile__preview--siblings" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </span>
            <span class="tile__name">Siblings</span>
            <span class="tile__text">Cards that know their own position and how many there are, then pick their color, number and animation delay.</span>
            <span class="tile__footer">
              <span class="tile__tags"><code>sibling-index()</code><code>sibling-count()</code></span>
              <span class="tile__arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
        <li>
          <a class="tile" href="./grid/index.html">
            <span class="tile__preview tile__preview--grid" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span><span></span>
            </span>
            <span class="tile__name">Grid</span>
            <span class="tile__text">Up to N columns that drop on their own when they'd get too narrow. No breakpoints, and cells that adapt to their own width.</span>
            <span class="tile__footer">
              <span class="tile__tags"><code>grid</code><code>auto-fill</code><code>@container</code></span>
              <span class="tile__arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
        <li>
          <a class="tile" href="./subgrid/index.html">
            <span class="tile__preview tile__preview--subgrid" aria-hidden="true">
              <span class="mini"><span class="mini__img"></span><span class="mini__lines"><span></span><span></span></span><span class="mini__price"></span></span>
              <span class="mini"><span class="mini__img"></span><span class="mini__lines"><span></span></span><span class="mini__price"></span></span>
              <span class="mini"><span class="mini__img"></span><span class="mini__lines"><span></span><span></span><span></span></span><span class="mini__price"></span></span>
            </span>
            <span class="tile__name">Subgrid</span>
            <span class="tile__text">Cards and form fields that share their parent grid's rows or columns, so titles, text, prices and inputs line up.</span>
            <span class="tile__footer">
              <span class="tile__tags"><code>subgrid</code><code>grid-template-rows</code></span>
              <span class="tile__arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
        <li>
          <a class="tile" href="./popover/index.html">
            <span class="tile__preview tile__preview--popover" aria-hidden="true">
              <span class="pop-btn">Button</span>
              <span class="pop-box"><span></span><span></span></span>
            </span>
            <span class="tile__name">Popover</span>
            <span class="tile__text">Menus and tooltips without JavaScript: native popovers placed next to their button, flipping when there isn't room.</span>
            <span class="tile__footer">
              <span class="tile__tags"><code>popover</code><code>anchor()</code><code>@position-try</code></span>
              <span class="tile__arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
        <li>
          <a class="tile" href="./cq-units/index.html">
            <span class="tile__preview tile__preview--cq" aria-hidden="true">
              <span class="cq-mini cq-mini--wide"><b>Aa</b></span>
              <span class="cq-mini"><b>Aa</b></span>
            </span>
            <span class="tile__name">Container Units</span>
            <span class="tile__text">Titles sized with cqi follow their card, not the screen: wide card, big title; narrow card, smaller title.</span>
            <span class="tile__footer">
              <span class="tile__tags"><code>cqi</code><code>cqw</code><code>container-type</code></span>
              <span class="tile__arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
