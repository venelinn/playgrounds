<%- include("/partials/head", {
  title: "Popover Playground",
  description: "Native popovers positioned with CSS anchor positioning: placements, flipping, animation, no JavaScript needed.",
  appClass: "popover-playground",
  appId: "app",
  tour: true,
  styles: [
    "/shared/controls.css",
    "/shared/compat.css",
    "/shared/tour.css",
    "/shared/info.css",
    "/shared/grid.css",
    "/pages/popover/style.css",
  ],
  scripts: [
    "/shared/compat.js",
    "/shared/tour.js",
    "/shared/info.js",
    "/pages/popover/placement.js",
    "/pages/popover/script.js",
  ],
}) %>
      <p class="app__intro">
        Menus, tooltips and dropdowns without JavaScript. A button with <code>popovertarget</code> opens a
        <code>popover</code>, the browser puts it <strong>on top of everything</strong> (no z-index, no portal), and
        <strong>anchor positioning</strong> places it next to its button. When there isn't room, it
        <strong>flips</strong> to the other side by itself.
      </p>
      <p class="warning" id="support-note" role="status" hidden></p>

      <div class="controls">
        <fieldset class="control control--placement">
          <legend class="control__label">Placement: <strong id="placement-name">bottom-start</strong></legend>
          <div class="picker" id="picker">
            <span class="picker__anchor" aria-hidden="true">button</span>
          </div>
        </fieldset>

        <div class="control">
          <label class="control__label" for="type">Type</label>
          <select class="control__field" id="type">
            <option value="manual" selected>manual</option>
            <option value="auto">auto</option>
            <option value="hint">hint</option>
          </select>
          <p class="control__hint" id="type-hint"></p>
        </div>

        <%- include("/components/control/control", {
          id: "offset",
          label: "Offset",
          min: 0,
          max: 32,
          step: 1,
          value: 6,
          unit: "px",
          hint: "Space between the button and the popover."
        }) %>

        <%- include("/components/control/control", {
          id: "duration",
          label: "Animation",
          min: 0,
          max: 600,
          step: 20,
          value: 180,
          unit: "ms",
          sliderLabel: "Animation duration",
          hint: "Fade and slide in and out. 0 = no animation."
        }) %>

        <div class="control control--switch">
          <label class="switch">
            <input class="switch__input" type="checkbox" id="flip" checked>
            <span class="switch__label">Flip when out of room</span>
          </label>
          <p class="control__hint">Off = no <code>position-try-fallbacks</code>: it overflows the window instead.</p>
        </div>
      </div>

      <section class="stage" aria-labelledby="builder-title">
        <div class="stage__bar">
          <h2 class="stage__heading" id="builder-title">Builder</h2>
          <span class="stage__hint">Drag the button toward an edge of the window to make it flip</span>
        </div>
        <p class="stage__check" id="readout" role="status"></p>
        <div class="playfield" id="playfield">
          <div class="popover-root popover-root--drag" id="builder-root">
            <button class="trigger trigger--main" id="builder-trigger" type="button" popovertarget="builder">
              <svg class="trigger__grip" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="6" r="1"/><circle cx="15" cy="6" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="18" r="1"/></svg>
              Open popover
            </button>
            <div id="builder" class="popover-content" popover="manual" data-placement="bottom-start">
              <div class="surface">
                <strong id="builder-title-text">bottom-start</strong>
                <span id="builder-text">Anchored to the button</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="compare">
        <div class="card">
          <div class="card__head">
            <span class="card__title">HTML</span>
            <button class="card__button" type="button" data-copy="html-code">Copy</button>
          </div>
          <pre class="card__code"><code id="html-code"></code></pre>
        </div>
        <div class="card">
          <div class="card__head">
            CSS
            <button class="card__button" type="button" data-copy="css-code">Copy</button>
          </div>
          <pre class="card__code"><code id="css-code"></code></pre>
        </div>
      </div>

      <section class="stage" aria-labelledby="matrix-title">
        <div class="stage__bar">
          <h2 class="stage__heading" id="matrix-title">All twelve placements</h2>
        </div>
        <p class="stage__explain">
          These use <code>popover="manual"</code>, so you can open several at once to compare. Click a button again
          to close it. Offset and animation follow the settings above.
        </p>
        <div class="matrix" id="matrix"></div>
      </section>

      <section class="stage" aria-labelledby="clip-title">
        <div class="stage__bar">
          <h2 class="stage__heading" id="clip-title">Escapes <code>overflow: hidden</code></h2>
        </div>
        <p class="stage__explain">
          The button sits inside a small box with <code>overflow: hidden</code>. The popover isn't cut off, because it
          renders in the browser's <strong>top layer</strong>, above the page.
        </p>
        <div class="clipped">
          <div class="popover-root" id="clip-root">
            <button class="trigger" type="button" popovertarget="clip">Open inside a clipped box</button>
            <div id="clip" class="popover-content" popover="auto" data-placement="bottom-start">
              <div class="surface"><strong>Not clipped</strong><span>No portal, no z-index: the top layer handles it</span></div>
            </div>
          </div>
        </div>
      </section>

<%- include("/partials/footer", {
  features: [
    {
      feature: "popover",
      label: "Popover (popover, popovertarget)",
      test: "dom:popover",
      caniuse: "popover",
      mdn: "https://developer.mozilla.org/en-US/docs/Web/API/Popover_API"
    },
    {
      feature: "anchor-positioning",
      test: "anchor-name: --a",
      caniuse: "anchor positioning",
      mdn: "https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Anchor_positioning",
      note: "The versions are for the full spec. The parts used here (anchor(), anchor-center, @position-try) work in Chrome/Edge 125+, Safari 26+ and Firefox 147+. Older browsers show the popover centered instead."
    },
    {
      feature: "popover-hint",
      test: "dom:popover-hint",
      caniuse: "popover hint",
      mdn: "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Global_attributes/popover"
    },
    {
      feature: "starting-style",
      label: "@starting-style (open animation)",
      test: "transition-behavior: allow-discrete",
      caniuse: "starting-style",
      mdn: "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/At-rules/@starting-style"
    },
  ],
}) %>
