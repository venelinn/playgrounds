<%#
  Page start: <head>, the panel, back link, tour + theme buttons and the title.
  Close it with partials/footer.

  title        page title (also the <h1>)
  description  meta description (optional)
  styles       stylesheets after shared/base.css, e.g. ["/shared/controls.css", "/pages/clamp/style.css"]
  scripts      module scripts after shared/theme.js, e.g. ["/shared/tour.js", "/pages/clamp/script.js"]
  tour         true = load driver.js and show the "?" walkthrough button
  home         true = the gallery page (no back link)
  back         back link to the gallery, relative to the page; default "../index.html"
  appClass     extra class on <main class="app">
  appId        id on <main> (optional)
-%>
<%
  const _styles = typeof styles !== "undefined" ? styles : [];
  const _scripts = typeof scripts !== "undefined" ? scripts : [];
  const _tour = typeof tour !== "undefined" && tour;
  const _home = typeof home !== "undefined" && home;
  const _back = typeof back !== "undefined" ? back : "../index.html";
  const _appClass = typeof appClass !== "undefined" && appClass ? ` ${appClass}` : "";
-%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
<% if (typeof description !== "undefined") { -%>
    <meta name="description" content="<%= description %>">
<% } -%>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..800&display=swap">
<% if (_tour) { -%>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css">
<% } -%>
    <link rel="stylesheet" href="/shared/base.css">
<% _styles.forEach((href) => { -%>
    <link rel="stylesheet" href="<%= href %>">
<% }) -%>
    <script>
      // Set the theme before first paint (saved choice, else system).
      try {
        const saved = localStorage.getItem("playground-theme");
        document.documentElement.dataset.theme = saved || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      } catch {
        document.documentElement.dataset.theme = "dark";
      }
    </script>
<% if (_tour) { -%>
    <script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.js.iife.js" defer></script>
<% } -%>
    <script type="module" src="/shared/theme.js"></script>
<% _scripts.forEach((src) => { -%>
    <script type="module" src="<%= src %>"></script>
<% }) -%>
  </head>

  <body>
    <main class="app<%= _appClass %>"<% if (typeof appId !== "undefined") { %> id="<%= appId %>"<% } %>>
<% if (!_home) { -%>
      <nav class="app__nav">
        <a class="app__action" href="<%= _back %>" title="All playgrounds">
          <svg class="app__icon app__icon--back" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
          <span class="sr-only">All playgrounds</span>
        </a>
      </nav>
<% } -%>
      <div class="app__actions">
<% if (_tour) { -%>
        <button class="app__action" type="button" id="tour-start" aria-label="Show the walkthrough" title="Show the walkthrough">
          <svg class="app__icon app__icon--help" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M9.5 9.2a2.6 2.6 0 0 1 5 .9c0 1.7-2.5 2.3-2.5 3.9"/><path d="M12 17.2h.01"/></svg>
        </button>
<% } -%>
        <button class="app__action" type="button" id="theme-toggle" aria-label="Switch theme">
          <svg class="app__icon app__icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="app__icon app__icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>

      <h1 class="app__title"><%= title %></h1>
